[Unit]
Description=Live Studio LLM proxy
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/live-studio/proxy
Environment=ANTHROPIC_API_KEY=ЗАМЕНИ_НА_СВОЙ_КЛЮЧ
Environment=ALLOWED_ORIGIN=https://USERNAME.github.io
ExecStart=/opt/live-studio/venv/bin/uvicorn app:app --host 127.0.0.1 --port 8787
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
